generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String           @id @default(cuid())
  name            String
  shortName       String           @unique
  logo            String?
  email           String?
  phone           String?
  address         String?
  primaryColor    String?          @default("#0F172A")
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bankAccounts    BankAccount[]
  colleges        College[]
  departments     Department[]
  invitations     Invitation[]
  notifications   Notification[]
  paymentTypes    PaymentType[]
  receiptTemplate ReceiptTemplate?
  transactions    Transaction[]
  users           User[]
  wallet          Wallet?
  withdrawals     Withdrawal[]
  walletHistories WalletHistory[]
}

model Department {
  id              String          @id @default(cuid())
  name            String
  organizationId  String
  collegeId       String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  college         College?        @relation(fields: [collegeId], references: [id])
  organization    Organization    @relation(fields: [organizationId], references: [id])
  invitations     Invitation[]
  notifications   Notification[]
  paymentTypes    PaymentType[]
  transactions    Transaction[]
  users           User[]
  withdrawals     Withdrawal[]
  bankAccounts    BankAccount[]
  walletHistories WalletHistory[]
  wallet          Wallet?
}

model AcademicSession {
  id           String        @id @default(cuid())
  name         String        @unique
  active       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model PaymentType {
  id            String  @id @default(cuid())
  title         String
  description   String?
  defaultAmount Float

  level100Amount Float?

  organizationId    String
  collegeId         String?
  departmentId      String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  allowCustomAmount Boolean   @default(false)
  createdBy         String?
  dueDate           DateTime?
  maximumAmount     Float?
  minimumAmount     Float?

  college      College?      @relation(fields: [collegeId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  transactions Transaction[]
}

model ReceiptTemplate {
  id             String       @id @default(cuid())
  organizationId String       @unique
  logo           String?
  footerText     String?
  watermark      String?
  primaryColor   String       @default("#0F172A")
  secondaryColor String       @default("#F8FAFC")
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Transaction {
  id             String          @id @default(cuid())
  receiptId      String          @unique
  reference      String          @unique
  payerName      String
  email          String
  phone          String?
  matricNumber   String?
  level          String?
  amount         Decimal         @db.Decimal(18, 2)
  platformFee    Decimal         @default(0) @db.Decimal(18, 2)
  grossAmount    Decimal         @db.Decimal(18, 2)
  netAmount      Decimal         @db.Decimal(18, 2)
  currency       String
  paymentStatus  PaymentStatus   @default(PENDING)
  paymentMethod  PaymentMethod?
  description    String?
  paymentDate    DateTime?
  verifiedAt     DateTime?
  verifiedBy     String?
  receiptSent    Boolean         @default(false)
  organizationId String
  collegeId      String?
  departmentId   String?
  paymentTypeId  String
  sessionId      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  college        College?        @relation(fields: [collegeId], references: [id])
  department     Department?     @relation(fields: [departmentId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  paymentType    PaymentType     @relation(fields: [paymentTypeId], references: [id])
  session        AcademicSession @relation(fields: [sessionId], references: [id])

  @@index([email])
  @@index([reference])
  @@index([paymentStatus])
  @@index([organizationId])
  @@index([createdAt])
}

model User {
  id             String         @id @default(cuid())
  fullName       String
  email          String         @unique
  password       String
  phone          String?
  role           UserRole
  organizationId String?
  collegeId      String?
  departmentId   String?
  active         Boolean        @default(true)
  lastLogin      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  invitationId   String?
  notifications  Notification[]
  auditLogs      AuditLog[]
  college        College?       @relation(fields: [collegeId], references: [id])
  department     Department?    @relation(fields: [departmentId], references: [id])
  organization   Organization?  @relation(fields: [organizationId], references: [id])
}

model Withdrawal {
  id String @id @default(cuid())

  walletId String

  organizationId String?
  collegeId      String?
  departmentId   String?

  amount Decimal @db.Decimal(18, 2)

  bankName      String
  accountNumber String
  accountName   String

  status WithdrawalStatus @default(PENDING)

  requestedBy String
  approvedBy  String?

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  paidAt      DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id])

  organization Organization? @relation(fields: [organizationId], references: [id])
  college      College?      @relation(fields: [collegeId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
}

model PlatformSettings {
  id            String   @id @default(cuid())
  feeType       FeeType
  feeValue      Decimal  @db.Decimal(18, 2)
  currency      String   @default("NGN")
  supportEmail  String?
  receiptPrefix String   @default("TKT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model College {
  id              String          @id @default(cuid())
  name            String
  shortName       String?
  email           String?
  phone           String?
  logo            String?
  active          Boolean         @default(true)
  organizationId  String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id])
  departments     Department[]
  invitations     Invitation[]
  notifications   Notification[]
  paymentTypes    PaymentType[]
  transactions    Transaction[]
  users           User[]
  withdrawals     Withdrawal[]
  bankAccounts    BankAccount[]
  walletHistories WalletHistory[]
  wallet          Wallet?

  @@unique([organizationId, name])
}

model BankAccount {
  id String @id @default(cuid())

  organizationId String?
  collegeId      String?
  departmentId   String?

  bankCode      String
  bankName      String
  accountName   String
  accountNumber String

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  college      College?      @relation(fields: [collegeId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
}

model Invitation {
  id             String        @id @default(cuid())
  email          String
  token          String        @unique
  role           UserRole
  organizationId String?
  collegeId      String?
  departmentId   String?
  expiresAt      DateTime
  accepted       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  fullName       String
  college        College?      @relation(fields: [collegeId], references: [id])
  department     Department?   @relation(fields: [departmentId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([email])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model Wallet {
  id String @id @default(uuid())

  organizationId String?
  collegeId      String?
  departmentId   String?

  availableBalance Decimal @default(0) @db.Decimal(18, 2)
  pendingBalance   Decimal @default(0) @db.Decimal(18, 2)
  reservedBalance  Decimal @default(0) @db.Decimal(18, 2)
  withdrawnBalance Decimal @default(0) @db.Decimal(18, 2)
  totalRevenue     Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  college      College?      @relation(fields: [collegeId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])

  histories   WalletHistory[]
  withdrawals Withdrawal[]

  @@unique([organizationId])
  @@unique([collegeId])
  @@unique([departmentId])
}

model WalletHistory {
  id String @id @default(cuid())

  walletId       String
  organizationId String
  collegeId      String?
  departmentId   String?

  type WalletHistoryType

  amount        Decimal @db.Decimal(18, 2)
  balanceBefore Decimal @db.Decimal(18, 2)
  balanceAfter  Decimal @db.Decimal(18, 2)

  reference   String?
  description String?

  createdAt DateTime @default(now())

  wallet       Wallet       @relation(fields: [walletId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  college      College?     @relation(fields: [collegeId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])

  @@index([walletId])
  @@index([organizationId])
  @@index([collegeId])
  @@index([departmentId])
  @@index([createdAt])
}

model Notification {
  id             String           @id @default(cuid())
  title          String
  message        String
  type           NotificationType @default(INFO)
  read           Boolean          @default(false)
  userId         String?
  organizationId String?
  collegeId      String?
  departmentId   String?
  createdAt      DateTime         @default(now())
  college        College?         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department     Department?      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([collegeId])
  @@index([departmentId])
  @@index([createdAt])
}

model PlatformFee {
  id String @id @default(cuid())

  percentage Decimal  @default(1.50) @db.Decimal(5, 2)
  flat       Decimal  @default(50) @db.Decimal(18, 2)
  cap        Decimal? @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum WalletHistoryType {
  PAYMENT
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
  ADJUSTMENT
  RESERVE
  RELEASE
}

enum UserRole {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
  COLLEGE_ADMIN
  DEPARTMENT_ADMIN
  FINANCE_OFFICER
  VIEWER
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

enum FeeType {
  FIXED
  PERCENTAGE
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
  WALLET
  BUDPAY
}
